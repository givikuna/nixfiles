show_hidden = true
show_symlink = true
sort_by = "natural"
sort_sensitive = false
sort_dir_first = true

[opener]
edit = [
    { run = 'code "$@"', block = true, desc = "code" }
]
play = [
    { run = 'mpv "$@"', orphan = true, desc = "MPV" }
]
view = [
    { run = 'imv "$@"', orphan = true, desc = "IMV" }
]
reveal = [
    { run = 'xdg-open "$@"', desc = "System Default" }
]

[open]
rules = [
    { mime = "text/*", use = [ "edit", "reveal" ] },
    { mime = "application/json", use = [ "edit", "reveal" ] },

    { mime = "image/*", use = [ "view", "reveal" ] },
    { mime = "video/*", use = [ "play", "reveal" ] },
    { mime = "audio/*", use = [ "play", "reveal" ] },

    { url = "*", use = [ "reveal", "edit" ] }
]
</file>

<file path="flake-modules/tests/tests.nix">
{
  inputs,
  pkgs,
  nixosConfigurations,
  ...
}:
let
  lib = pkgs.lib;
  ntlib = inputs.nixtest.lib { inherit pkgs; };

  all-files = lib.filesystem.listFilesRecursive ../../tests;

  test-mods = builtins.filter (f: lib.hasSuffix "_test.nix" (toString f)) all-files;

  _ = builtins.trace "found test files of: ${builtins.toJSON (map toString test-mods)}" null;
in
ntlib.mkNixtest {
  modules = test-mods;

  args = {
    inherit
      pkgs
      ntlib
      inputs
      nixosConfigurations
      ;
  };
}
</file>

