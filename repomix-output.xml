hl.bind(
    mainMod .. " + CONTROL + ALT + LEFT",
    hl.dsp.window.move {
        monitor = "HDMI-A-1",
    }
)
hl.bind(
    mainMod .. " + CONTROL + ALT + RIGHT",
    hl.dsp.window.move {
        monitor = "eDP-1",
    }
)

hl.bind(
    mainMod .. " + SHIFT + LEFT",
    hl.dsp.focus {
        direction = "l",
    }
)
hl.bind(
    mainMod .. " + SHIFT + RIGHT",
    hl.dsp.focus {
        direction = "r",
    }
)
hl.bind(
    mainMod .. " + SHIFT + UP",
    hl.dsp.focus {
        direction = "u",
    }
)
hl.bind(
    mainMod .. " + SHIFT + DOWN",
    hl.dsp.focus {
        direction = "d",
    }
)

hl.bind("ALT + TAB", hl.dsp.exec_cmd "walker --modules windows")

